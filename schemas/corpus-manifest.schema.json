{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hello-slm/schemas/corpus-manifest.schema.json",
  "title": "Hello SLM corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "name",
    "created_at",
    "entries"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "split",
        "sha256",
        "bytes",
        "conversation_count",
        "provenance",
        "license",
        "rights_holder",
        "consent",
        "allowed_use",
        "contains_personal_data",
        "contains_synthetic_data",
        "included"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.jsonl$"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "conversation_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "rights_holder": {
          "type": "string",
          "minLength": 1
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "training_allowed",
            "granted_by",
            "grant_reference"
          ],
          "properties": {
            "training_allowed": {
              "type": "boolean"
            },
            "granted_by": {
              "type": "string",
              "minLength": 1
            },
            "grant_reference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allowed_use": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tokenizer-training",
              "model-training",
              "validation",
              "test",
              "evaluation"
            ]
          }
        },
        "contains_personal_data": {
          "type": "boolean"
        },
        "contains_synthetic_data": {
          "type": "boolean"
        },
        "included": {
          "type": "boolean"
        },
        "exclusion_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "included": {
                "const": false
              }
            },
            "required": [
              "included"
            ]
          },
          "then": {
            "required": [
              "exclusion_reason"
            ]
          }
        }
      ]
    }
  }
}
