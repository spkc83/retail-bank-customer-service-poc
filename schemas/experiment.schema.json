{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hello-slm/schemas/experiment.schema.json",
  "title": "hello-SLM experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "run",
    "corpus",
    "tokenizer",
    "dataset",
    "model",
    "training",
    "checkpointing",
    "evaluation",
    "generation",
    "seeds"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_dir", "description", "allow_network"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
        "artifact_dir": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "allow_network": { "const": false }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "restricted_to_manifest",
        "enforce_manifest_split_only",
        "near_duplicate_mode",
        "split"
      ],
      "properties": {
        "manifest_path": { "type": "string", "minLength": 1 },
        "restricted_to_manifest": { "const": true },
        "enforce_manifest_split_only": { "type": "boolean" },
        "near_duplicate_mode": { "enum": ["exhaustive", "exact_only"] },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "train", "validation", "test"],
          "properties": {
            "method": { "const": "conversation_id_sha256_mod" },
            "train": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "validation": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "test": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
          }
        }
      }
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "vocab_size",
        "min_frequency",
        "character_policy",
        "normalization",
        "special_tokens"
      ],
      "properties": {
        "type": { "const": "restricted_bpe" },
        "vocab_size": { "type": "integer", "minimum": 64, "maximum": 65536 },
        "min_frequency": { "type": "integer", "minimum": 1 },
        "character_policy": { "enum": ["reject", "unk"] },
        "normalization": { "const": "nfc" },
        "allowed_characters": { "type": "string" },
        "merge_digits": { "type": "boolean" },
        "special_tokens": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^<[^<>]+>$" }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_seq_len", "packing", "loss_mask"],
      "properties": {
        "max_seq_len": { "type": "integer", "minimum": 8, "maximum": 8192 },
        "packing": { "enum": ["fixed_block"] },
        "loss_mask": { "const": "assistant_only" },
        "drop_remainder": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "vocab_size",
        "max_seq_len",
        "n_layers",
        "d_model",
        "n_heads",
        "n_kv_heads",
        "d_ff",
        "norm",
        "mlp",
        "rope_base",
        "dropout",
        "tie_embeddings",
        "init_std",
        "residual_init_scale",
        "parameter_cap"
      ],
      "properties": {
        "architecture": { "const": "decoder_only_causal_transformer" },
        "vocab_size": { "type": "integer", "minimum": 64, "maximum": 65536 },
        "max_seq_len": { "type": "integer", "minimum": 8, "maximum": 8192 },
        "n_layers": { "type": "integer", "minimum": 1, "maximum": 128 },
        "d_model": { "type": "integer", "minimum": 32, "maximum": 4096 },
        "n_heads": { "type": "integer", "minimum": 1, "maximum": 128 },
        "n_kv_heads": { "type": "integer", "minimum": 1, "maximum": 128 },
        "d_ff": { "type": "integer", "minimum": 64, "maximum": 16384 },
        "norm": { "const": "rmsnorm" },
        "mlp": { "const": "swiglu" },
        "rope_base": { "type": "number", "exclusiveMinimum": 1 },
        "dropout": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "tie_embeddings": { "const": true },
        "init_std": { "type": "number", "exclusiveMinimum": 0 },
        "residual_init_scale": { "enum": ["none", "deepnorm-lite"] },
        "parameter_cap": { "type": "integer", "maximum": 500000000 }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "precision",
        "allow_precision_fallback",
        "total_steps",
        "micro_batch_size",
        "gradient_accumulation_steps",
        "drop_last",
        "optimizer",
        "scheduler",
        "max_grad_norm"
      ],
      "properties": {
        "device": { "enum": ["cpu", "cuda"] },
        "precision": { "enum": ["float32", "bfloat16"] },
        "allow_precision_fallback": { "type": "boolean" },
        "total_steps": { "type": "integer", "minimum": 1 },
        "micro_batch_size": { "type": "integer", "minimum": 1 },
        "gradient_accumulation_steps": { "type": "integer", "minimum": 1 },
        "drop_last": { "type": "boolean" },
        "max_grad_norm": { "type": "number", "exclusiveMinimum": 0 },
        "optimizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "learning_rate", "betas", "eps", "weight_decay"],
          "properties": {
            "name": { "const": "adamw" },
            "learning_rate": { "type": "number", "exclusiveMinimum": 0 },
            "betas": {
              "type": "array",
              "prefixItems": [
                { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
                { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "eps": { "type": "number", "exclusiveMinimum": 0 },
            "weight_decay": { "type": "number", "minimum": 0 }
          }
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "warmup_steps", "min_learning_rate"],
          "properties": {
            "name": { "const": "warmup_cosine" },
            "warmup_steps": { "type": "integer", "minimum": 0 },
            "min_learning_rate": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "checkpointing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_steps", "keep_last", "atomic", "strict_resume"],
      "properties": {
        "interval_steps": { "type": "integer", "minimum": 1 },
        "keep_last": { "type": "integer", "minimum": 1 },
        "atomic": { "const": true },
        "strict_resume": { "const": true }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_steps", "eval_at_step_zero", "metrics"],
      "properties": {
        "interval_steps": { "type": "integer", "minimum": 1 },
        "eval_at_step_zero": { "type": "boolean" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "loss",
              "perplexity",
              "assistant_token_accuracy",
              "arithmetic_exact_match"
            ]
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_new_tokens", "temperature", "top_k", "top_p", "repetition_penalty"],
      "properties": {
        "max_new_tokens": { "type": "integer", "minimum": 1, "maximum": 512 },
        "temperature": { "type": "number", "minimum": 0 },
        "top_k": { "type": "integer", "minimum": 0 },
        "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "repetition_penalty": { "type": "number", "minimum": 1 }
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_split", "tokenizer", "dataset", "model", "dataloader", "generation"],
      "properties": {
        "corpus_split": { "type": "integer", "minimum": 0 },
        "tokenizer": { "type": "integer", "minimum": 0 },
        "dataset": { "type": "integer", "minimum": 0 },
        "model": { "type": "integer", "minimum": 0 },
        "dataloader": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
