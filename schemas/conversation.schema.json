{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hello-slm/schemas/conversation.schema.json",
  "title": "Hello SLM conversation JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversation_id",
    "source",
    "license",
    "created_at",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "conversation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "loss": {
          "type": "boolean"
        }
      }
    }
  }
}
